# 複製此檔為 .env 並填入實際值。.env 已被 gitignore，切勿提交。
# 取得位置：Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# 注意：Edge Function 的密鑰（LINE_CHANNEL_ACCESS_TOKEN、LINE_CHANNEL_SECRET、
# GEMINI_API_KEY、WEBAPP_URL 等）不放在這裡，改用 `supabase secrets set` 設定。
# 詳見 docs/SETUP.md。
